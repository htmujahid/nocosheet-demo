  "tables": [
    {
      "name": "Properties",
      "icon": "building-2",
      "group": "Portfolio",
      "description": "Units you own or manage.",
      "title": "Name",
      "audit": true,
      "columns": [
        {
          "name": "Name",
          "format": "text",
          "required": true,
          "searchable": true
        },
        {
          "name": "Address",
          "format": "text"
        },
        {
          "name": "City",
          "format": "text"
        },
        {
          "name": "Type",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Apartment",
                "value": "apartment"
              },
              {
                "label": "House",
                "value": "house"
              },
              {
                "label": "Studio",
                "value": "studio"
              },
              {
                "label": "Duplex",
                "value": "duplex"
              }
            ]
          },
          "filterable": true,
          "sortable": true
        },
        {
          "name": "Bedrooms",
          "format": "integer",
          "check": "{Bedrooms} >= 0"
        },
        {
          "name": "Monthly rent",
          "format": "currency",
          "options": {
            "currency": "GBP",
            "precision": 0
          },
          "check": "{Monthly rent} >= 0"
        },
        {
          "name": "Status",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Occupied",
                "value": "occupied"
              },
              {
                "label": "Vacant",
                "value": "vacant"
              },
              {
                "label": "Maintenance",
                "value": "maintenance"
              }
            ]
          },
          "filterable": true,
          "sortable": true,
          "default": "vacant"
        }
      ],
      "views": [
        {
          "name": "Vacant",
          "icon": "door-open",
          "description": "Units available to let.",
          "columns": ["Name", "City", "Type", "Bedrooms", "Monthly rent"],
          "filters": [
