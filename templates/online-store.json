    {
      "name": "Products",
      "icon": "package",
      "group": "Catalog",
      "description": "What you sell, with price, cost and stock value.",
      "title": "Name",
      "audit": true,
      "columns": [
        {
          "name": "Name",
          "format": "text",
          "required": true,
          "searchable": true
        },
        {
          "name": "SKU",
          "format": "text",
          "required": true,
          "unique": true
        },
        {
          "name": "Category",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Apparel",
                "value": "apparel"
              },
              {
                "label": "Accessories",
                "value": "accessories"
              },
              {
                "label": "Home",
                "value": "home"
              },
              {
                "label": "Beauty",
                "value": "beauty"
              }
            ]
          },
          "filterable": true,
          "sortable": true
        },
        {
          "name": "Price",
          "format": "currency",
          "options": {
            "currency": "USD",
            "precision": 2
          },
          "required": true,
          "check": "{Price} > 0"
        },
        {
          "name": "Cost",
          "format": "currency",
          "options": {
            "currency": "USD",
            "precision": 2
          },
          "check": "{Cost} >= 0"
        },
        {
          "name": "Stock",
          "format": "integer",
          "filterable": true,
          "sortable": true,
          "default": "0",
          "check": "{Stock} >= 0"
        },
        {
          "name": "Reorder level",
          "format": "integer",
          "default": "0"
        },
        {
          "name": "Stock value",
          "format": "currency",
          "options": {
            "currency": "USD",
            "precision": 2
          },
          "generated": "{Cost} * {Stock}"
        },
        {
          "name": "Active",
          "format": "checkbox",
          "filterable": true,
          "sortable": true,
          "default": "true"
        }
      ],
      "views": [
        {
          "name": "Low stock",
          "icon": "trending-down",
          "description": "Products with fewer than 10 units left.",
          "columns": ["Name", "SKU", "Stock", "Reorder level"],
          "filters": [
            {
              "column": "Stock",
              "op": "lt",
              "value": 10
            }
          ]
        },
        {
          "name": "Active catalog",
          "icon": "package-check",
          "description": "Products on sale.",
          "columns": ["Name", "Category", "Price", "Stock"],
          "filters": [
            {
              "column": "Active",
              "op": "is",
              "value": true
            }
          ]
        }
      ],
