    {
      "name": "Orders",
      "icon": "shopping-cart",
      "group": "Sales",
      "description": "Every customer order from placed to delivered.",
      "title": "Number",
      "audit": true,
      "columns": [
        {
          "name": "Number",
          "format": "text",
          "required": true,
          "searchable": true
