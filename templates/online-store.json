          "relation": "Customers"
        },
        {
          "name": "Status",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "New",
                "value": "new"
              },
              {
                "label": "Paid",
                "value": "paid"
              },
              {
                "label": "Packed",
                "value": "packed"
              },
              {
                "label": "Shipped",
                "value": "shipped"
              },
              {
                "label": "Delivered",
                "value": "delivered"
              },
              {
                "label": "Cancelled",
                "value": "cancelled"
              },
              {
                "label": "Refunded",
                "value": "refunded"
              }
            ]
          },
          "filterable": true,
          "sortable": true,
          "default": "new"
        },
        {
          "name": "Channel",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Website",
                "value": "website"
              },
              {
                "label": "Instagram",
                "value": "instagram"
              },
              {
                "label": "Marketplace",
                "value": "marketplace"
              },
              {
                "label": "In person",
                "value": "in_person"
              }
            ]
          },
          "filterable": true,
          "sortable": true
        },
        {
          "name": "Total",
          "format": "currency",
          "options": {
            "currency": "USD",
            "precision": 2
          },
          "required": true,
          "check": "{Total} >= 0"
        },
        {
          "name": "Ordered",
          "format": "date"
        },
        {
          "name": "Shipped",
          "format": "date"
        },
        {
          "name": "Tracking number",
          "format": "text"
        },
        {
          "name": "Notes",
          "format": "long_text"
        }
      ],
      "views": [
        {
          "name": "To fulfil",
          "icon": "box",
          "description": "Paid or packed orders waiting to ship.",
          "columns": ["Number", "Customer", "Status", "Total", "Ordered"],
          "filters": [
            {
              "column": "Status",
              "op": "is_any_of",
              "value": ["new", "paid", "packed"]
            }
          ]
        },
        {
          "name": "In transit",
          "icon": "truck",
          "description": "Shipped, not yet delivered.",
          "columns": ["Number", "Customer", "Shipped", "Tracking number"],
          "filters": [
            {
              "column": "Status",
              "op": "is",
              "value": "shipped"
            }
          ]
        }
      ],
