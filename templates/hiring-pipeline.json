        {
          "name": "Status",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Draft",
                "value": "draft"
              },
              {
                "label": "Open",
                "value": "open"
              },
              {
                "label": "On hold",
                "value": "on_hold"
              },
              {
                "label": "Filled",
                "value": "filled"
              }
            ]
          },
          "filterable": true,
          "sortable": true,
          "default": "draft"
        },
        {
          "name": "Location",
          "format": "text"
        },
        {
          "name": "Salary min",
          "format": "currency",
          "options": {
            "currency": "EUR",
            "precision": 0
          },
          "check": "{Salary min} >= 0"
        },
        {
          "name": "Salary max",
          "format": "currency",
          "options": {
            "currency": "EUR",
            "precision": 0
          },
          "check": "{Salary max} >= {Salary min}"
        },
        {
          "name": "Openings",
          "format": "integer",
          "default": "1",
          "check": "{Openings} >= 1"
        },
        {
          "name": "Opened",
          "format": "date"
        },
        {
          "name": "Hiring manager",
          "format": "relation",
          "options": {
            "onDelete": "set null"
          },
          "relation": "Interviewers"
        },
        {
          "name": "Description",
          "format": "long_text"
        }
