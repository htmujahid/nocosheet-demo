        {
          "name": "Title",
          "format": "text",
          "required": true,
          "searchable": true
        },
        {
          "name": "Department",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Engineering",
                "value": "engineering"
              },
              {
                "label": "Design",
                "value": "design"
              },
              {
                "label": "Product",
                "value": "product"
              },
              {
                "label": "Operations",
                "value": "operations"
              }
            ]
          },
          "filterable": true,
          "sortable": true
