        {
          "name": "Name",
          "format": "text",
          "required": true,
          "searchable": true
        },
        {
          "name": "Email",
          "format": "email"
        },
        {
          "name": "Status",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Lead",
                "value": "lead"
              },
              {
                "label": "Active",
                "value": "active"
              },
              {
                "label": "Past",
                "value": "past"
              }
            ]
          },
          "filterable": true,
          "sortable": true,
          "default": "lead"
