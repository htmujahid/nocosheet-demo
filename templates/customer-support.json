    {
      "name": "Tickets",
      "icon": "ticket",
      "group": "Support",
      "description": "Every customer request and its status.",
      "title": "Subject",
      "audit": true,
      "columns": [
        {
          "name": "Subject",
          "format": "text",
          "required": true,
          "searchable": true
        },
        {
          "name": "Customer",
          "format": "relation",
          "options": {
            "onDelete": "set null"
          },
          "relation": "Customers"
        },
        {
          "name": "Assignee",
          "format": "relation",
          "options": {
            "onDelete": "set null"
          },
          "relation": "Agents"
        },
        {
          "name": "Channel",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Email",
                "value": "email"
              },
              {
                "label": "Chat",
                "value": "chat"
              },
              {
                "label": "Phone",
                "value": "phone"
              },
              {
                "label": "Social",
                "value": "social"
              }
            ]
          },
          "filterable": true,
          "sortable": true
        },
        {
          "name": "Priority",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Low",
                "value": "low"
              },
              {
                "label": "Normal",
                "value": "normal"
              },
              {
                "label": "High",
                "value": "high"
              },
              {
                "label": "Urgent",
                "value": "urgent"
              }
            ]
          },
          "filterable": true,
          "sortable": true,
          "default": "normal"
        },
        {
          "name": "Status",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "New",
                "value": "new"
              },
              {
                "label": "Open",
                "value": "open"
              },
              {
                "label": "Waiting on customer",
                "value": "waiting_on_customer"
              },
              {
                "label": "Resolved",
                "value": "resolved"
              },
              {
                "label": "Closed",
                "value": "closed"
              }
            ]
          },
          "filterable": true,
          "sortable": true,
          "default": "new"
        },
        {
          "name": "Created",
          "format": "datetime"
        },
        {
          "name": "Satisfaction",
          "format": "rating",
          "options": {
            "max": 5
          }
        },
        {
          "name": "Description",
          "format": "long_text"
        }
      ],
      "views": [
        {
          "name": "Open tickets",
          "icon": "inbox",
          "description": "New or open tickets.",
          "columns": ["Subject", "Customer", "Assignee", "Priority", "Created"],
          "filters": [
            {
              "column": "Status",
              "op": "is_any_of",
              "value": ["new", "open"]
            }
          ]
        },
        {
          "name": "Urgent",
          "icon": "siren",
          "description": "Urgent and high priority tickets.",
          "columns": ["Subject", "Customer", "Status", "Assignee"],
          "filters": [
            {
              "column": "Priority",
              "op": "is_any_of",
              "value": ["high", "urgent"]
            }
          ]
        },
        {
          "name": "Waiting on customer",
          "icon": "hourglass",
          "description": "Ball is in the customer's court.",
          "columns": ["Subject", "Customer", "Assignee", "Created"],
          "filters": [
            {
              "column": "Status",
              "op": "is",
              "value": "waiting_on_customer"
            }
          ]
        }
      ],
      "rows": [
