{
  "version": 1,
  "id": "customer-support",
  "name": "Customer Support Desk",
  "description": "A lightweight help desk: agents, customers, tickets with priority and satisfaction, and a help article library.",
  "icon": "headset",
  "tags": ["support", "helpdesk", "sample"],
  "tables": [
    {
      "name": "Agents",
      "icon": "headset",
      "group": "Team",
      "description": "People answering customers.",
      "title": "Name",
      "columns": [
        {
          "name": "Name",
          "format": "text",
          "required": true,
          "searchable": true
        },
        {
          "name": "Email",
          "format": "email",
          "required": true,
          "unique": true
        },
        {
          "name": "Role",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Agent",
                "value": "agent"
              },
              {
                "label": "Team lead",
                "value": "team_lead"
              }
            ]
          },
          "filterable": true,
          "sortable": true
        },
        {
          "name": "Active",
          "format": "checkbox",
          "filterable": true,
          "sortable": true,
          "default": "true"
        }
      ],
      "views": [
        {
          "name": "Active agents",
          "icon": "users",
          "description": "On the support rota.",
          "columns": ["Name", "Email", "Role"],
          "filters": [
            {
              "column": "Active",
              "op": "is",
              "value": true
            }
          ]
        }
      ],
