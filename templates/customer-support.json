    {
      "name": "Help Articles",
      "icon": "book-open",
      "group": "Knowledge base",
      "description": "Self-service docs for customers.",
      "title": "Title",
      "columns": [
        {
          "name": "Title",
          "format": "text",
          "required": true,
          "searchable": true
        },
        {
          "name": "Category",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Getting started",
                "value": "getting_started"
              },
              {
                "label": "Billing",
                "value": "billing"
              },
              {
                "label": "Account",
                "value": "account"
              },
              {
                "label": "Troubleshooting",
                "value": "troubleshooting"
              }
            ]
          },
          "filterable": true,
          "sortable": true
        },
        {
          "name": "Status",
          "format": "single_select",
          "options": {
            "choices": [
              {
                "label": "Draft",
                "value": "draft"
              },
              {
                "label": "Published",
                "value": "published"
              }
            ]
          },
          "filterable": true,
          "sortable": true,
          "default": "draft"
        },
        {
          "name": "Views",
          "format": "integer",
          "default": "0",
          "check": "{Views} >= 0"
        },
        {
          "name": "Updated",
          "format": "date"
        },
        {
          "name": "URL",
          "format": "url"
        }
      ],
      "views": [
        {
          "name": "Published",
          "icon": "badge-check",
          "description": "Live articles.",
          "columns": ["Title", "Category", "Views", "Updated"],
          "filters": [
            {
              "column": "Status",
              "op": "is",
              "value": "published"
            }
          ]
        },
        {
          "name": "Drafts",
          "icon": "pencil",
          "description": "Articles to finish.",
          "columns": ["Title", "Category", "Updated"],
          "filters": [
            {
              "column": "Status",
              "op": "is",
              "value": "draft"
            }
          ]
        }
      ],
