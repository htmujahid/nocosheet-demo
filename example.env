# Google OAuth credentials (Google Cloud Console, APIs & Services, Credentials).
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=your-client-id
AUTH_GOOGLE_CLIENT_SECRET=your-client-secret

# Public values, embedded in the client bundle. In local development they come from this file;
# builds read them from the shell, not from .env.
VITE_WORKSPACE_NAME=My Workspace
VITE_ENABLE_SIGNUP=false
VITE_DEMO_MODE=false
